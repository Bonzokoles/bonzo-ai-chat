# Backend Environment Variables
# Copy this file to .env and configure

# Database
DATABASE_URL=sqlite:///./chat.db

# CORS - dozwolone origins (oddzielone przecinkami)
# Development: *
# Production: https://twoja-strona.pages.dev,https://twoja-domena.com
ALLOWED_ORIGINS=*

# MCP Tools Configuration
MCP_SAFE_DIR=./mcp_workspace
MCP_WEB_SEARCH_ENABLED=true
MCP_CODE_EXECUTION_ENABLED=true

# Model Configuration
MODEL_PATH=models/your-model-folder
MODEL_DEVICE=auto  # auto, cuda, cpu
MODEL_MAX_TOKENS=512

# Server Configuration
HOST=0.0.0.0
PORT=4149
KB_DIR=../knowledge_mood
APP_NAME=EastWood Ops
ASSISTANT_NAME=EASTWOOD
USER_NAME=Bonzo
KB_LABEL=KNOWLEDGE MOOD
UI_BASE_URL=http://localhost:4149

# Model routing
OPENROUTER_DEFAULT_MODEL=x-ai/grok-4.3
OPENROUTER_SECONDARY_MODEL=z-ai/glm-5.1
OPENROUTER_FALLBACK_MODEL=moonshotai/kimi-k2.6
AGENT_MODEL_PRIMARY=deepseek/deepseek-v4-pro
AGENT_MODEL_SECONDARY=minimax/minimax-m2.7
AGENT_MODEL_EXPERIMENTAL=tencent/hy3-preview

# Search / rerank
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-v4.0-fast

# Local model router
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
MODEL_ROUTER_DEFAULT_MODEL=buch-chat
MODEL_ROUTER_AUTO_DISCOVER_KEY=true

# ── 36 Chambers federation (The Buch → 36 Chambers orchestrator) ──────────
# Włącza dokładanie dowodów z federacji 9 komnat do kontekstu czatu (read-only, fail-soft).
# SHAOLIN_FEDERATION=1  -> włączone (domyślne)
# SHAOLIN_FEDERATION=0  -> wyłączone
# CHAMBERS_ORCHESTRATOR= ścieżka do shaolin_orchestrator.py (np. Z:/36_chambers/src/orchestrator/shaolin_orchestrator.py)
# CHAMBERS_ROOT= katalog główny 36 Chambers (fallback: <root>/src/orchestrator/shaolin_orchestrator.py)
SHAOLIN_FEDERATION=1
CHAMBERS_ORCHESTRATOR=
CHAMBERS_ROOT=
