# 9router — OpenAI-compatible gateway
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=sk-3c24a5e620a1959b-8nbsb0-ad90e4fd

# Modele bezpośrednie (nie combo) — combo "buch-agents" wybiera qwen2.5-coder-32b,
# który słabo obsługuje tool calls. llama-3.3-70b jest solidniejszy.
BUCH_MODEL=cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast
ORCHESTRATOR_MODEL=cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast
WORKER_MODEL=cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Ścieżka do RAG (względna do katalogu app/)
RAG_ROOT=../rag

# Opcjonalnie: wyłącz caveman w 9router jeśli Ci przeszkadza.
# caveman to token-saver który wstrzykuje system prompt "respond like a caveman".
# W tej apce NIE przeszkadza (workery nie mają tool calls). Zostaw ON.
# Żeby wyłączyć: sqlite3 ... UPDATE settings SET data=... WHERE id=1
# (patrz README → "Znane obejścia 9router bugów")
